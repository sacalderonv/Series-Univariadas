##Datos y Estadísticas ----
costo_siniestro <- c(8.943, 10.040,  5.955,  9.198,  9.566,  8.045,  4.597,  8.859, 12.169,  7.615,8.051,
7.042,  9.819,  8.008,  2.707,  3.373,  8.444,  9.188, 11.563, 8.841,  9.501,
7.991,  3.955,  8.188,  5.967, 12.595,  4.406, 10.383, 11.522,  9.848,
7.967,  9.790,  8.451)
alpha<-0.05
sigma<-3
n=length(costo_siniestro)
xbar=mean(costo_siniestro)
s=sd(costo_siniestro)
##Cuantiles t-Student
t_alpha2<-qt(alpha/2,df=n-1)
t_1_alpha2<-qt(1-alpha/2,df=n-1) #Note que son inversos aditivos
Lim_inf_t<-xbar+t_alpha2*s/sqrt(n)
Lim_sup_t<-xbar+t_1_alpha2*s/sqrt(n)
### Note la equivalencia con:
Lim_inf_t_1<-xbar-t_1_alpha2*s/sqrt(n)
Lim_sup_t_1<-xbar+t_1_alpha2*s/sqrt(n)
cat(paste0(
"El intervalo de confianza del 100(1-α)% (=",
round(100*(1-alpha)), "%) para μ es: (",
formatC(Lim_inf_t, format="f", digits=4), "; ",
formatC(Lim_sup_t, format="f", digits=4), ").\n"
))
#Cuantiles normal
z_alpha2<-qnorm(alpha/2,mean=0,sd=1)
z_1_alpha2<-qnorm(1-alpha/2,mean=0,sd=1)
Lim_inf_n<-xbar-z_1_alpha2*sigma/sqrt(n)
Lim_sup_n<-xbar+z_1_alpha2*sigma/sqrt(n)
cat(paste0(
"El intervalo de confianza del 100(1-α)% (=",
round(100*(1-alpha)), "%) para μ es: (",
formatC(Lim_inf_n, format="f", digits=4), "; ",
formatC(Lim_sup_n, format="f", digits=4), ").\n"
))
##IC varianza normal ----
alpha=0.01
chis_alpha2<-qchisq(alpha/2,df=n-1)
chis_1_alpha2<-qchisq(1-alpha/2,df=n-1)
var=s^2
L_inf_var<-(n-1)*var/chis_1_alpha2
L_sup_var<-(n-1)*var/chis_alpha2
cat(paste0(
"El intervalo de confianza del 100(1-α)% (=",
round(100*(1-alpha)), "%) para σ2 es: (",
formatC(L_inf_var, format="f", digits=4), "; ",
formatC(L_sup_var, format="f", digits=4), ").\n"
))
###Usando funciones ----
##### Para la media de una población normal, varianza desconocida----
library(OneTwoSamples)
t.test(costo_siniestro, conf.level = 0.99)
interval_estimate1(costo_siniestro, sigma = , alpha = 0.01)
sigma
##### Para la media de una población normal, varianza conocida----
interval_estimate1(costo_siniestro, sigma = sigma, alpha = 0.05)
interval_estimate4(costo_siniestro, sigma = sigma, side = 0, alpha = 0.05)
##Varianza desconocida ----
interval_estimate4(costo_siniestro, sigma = -1, side = 0, alpha = 0.05)
interval_var1(costo_siniestro, mu = Inf, alpha = 0.01)
interval_var3(costo_siniestro, mu = Inf, side = 0, alpha = 0.01)
one_sample(costo_siniestro, mu = Inf, sigma = -1, side = 0, alpha = 0.01)
