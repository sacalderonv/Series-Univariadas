data("AirPassengers")
plot(AirPassengers)
lAirPass=log(AirPassengers)
#x11()
par(mar = c(1,1,1,1))
par(mfrow=c(2,1))
plot(AirPassengers,main="Serie de Pasajeros sin Transformar")
