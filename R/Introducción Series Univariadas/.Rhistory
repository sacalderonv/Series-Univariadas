#Cuantiles normal
z_alpha2<-qnorm(alpha/2,mean=0,sd=1)
z_1_alpha2<-qnorm(1-alpha/2,mean=0,sd=1)
Lim_inf_n<-xbar-z_1_alpha2*sigma/sqrt(n)
Lim_sup_n<-xbar+z_1_alpha2*sigma/sqrt(n)
cat(paste0(
"El intervalo de confianza del 100(1-α)% (=",
round(100*(1-alpha)), "%) para μ es: (",
formatC(Lim_inf_n, format="f", digits=4), "; ",
formatC(Lim_sup_n, format="f", digits=4), ").\n"
))
