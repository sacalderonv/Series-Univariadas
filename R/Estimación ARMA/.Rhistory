lags = 0:10
# Gráfico base: ACF muestral
plot(lags,
acf_muestral$acf[1:11],
type = "h",
lwd = 2,
col = "black",
ylim = c(min(acf_teorica,
acf_muestral$acf[1:11]),
1),
xlab = "Rezago",
ylab = "ACF",
main = "ACF muestral vs teórica")
# ACF teórica en rojo punteado
lines(lags,
acf_teorica,
col = "red",
lty = 2,
lwd = 2)
# Puntos sobre la línea teórica
points(lags,
acf_teorica,
col = "red",
pch = 19)
abline(h = 0)
legend("topright",
legend = c("Muestral", "Teórica"),
col = c("black", "red"),
lty = c(1,2),
lwd = 2,
pch = c(NA,19))
