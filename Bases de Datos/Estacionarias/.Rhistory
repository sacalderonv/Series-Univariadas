resumen_sal <- function(lista, nombre_objeto, idx_dic) {
dfs <- lapply(lista, function(x) x[[nombre_objeto]])
num_data <- lapply(
dfs,
function(df) df[, sapply(df, is.numeric)]
)
# Media
promedio <- Reduce("+", num_data) / length(num_data)
# SD
sd_df <- as.data.frame(
lapply(seq_along(num_data[[1]]), function(j) {
apply(
do.call(cbind, lapply(num_data, function(df) df[[j]])),
1,
sd
)
})
)
names(sd_df) <- names(num_data[[1]])
# Agregar object
promedio$object <- dfs[[1]]$object
sd_df$object <- dfs[[1]]$object
promedio <- promedio[, c("object", setdiff(names(promedio), "object"))]
sd_df <- sd_df[, c("object", setdiff(names(sd_df), "object"))]
# Renombrar columnas
names(promedio)[4:7] <- c("APE","APE", "WIDTH", "WIDTH")
names(sd_df)[4:7] <- c("APE","APE", "WIDTH", "WIDTH")
# DIC
dic <- lapply(lista, function(x) x$DIC_models_dist)
promedio_DIC <- Reduce("+", lapply(dic, function(df) df[[1]])) / length(dic)
sd_DIC <- apply(
do.call(cbind, lapply(dic, function(df) df[[1]])),
1,
sd
)
# WAIC
waic <- lapply(lista, function(x) x$WAIC_models_dist)
promedio_WAIC <- Reduce("+", lapply(waic, function(df) df[[1]])) / length(waic)
sd_WAIC <- apply(
do.call(cbind, lapply(waic, function(df) df[[1]])),
1,
sd
)
# Agregar criterios
promedio$Valor_DIC <- promedio_DIC[idx_dic]
promedio$Valor_WAIC <- promedio_WAIC[idx_dic]
sd_df$sd_Valor_DIC <- sd_DIC[idx_dic]
sd_df$sd_Valor_WAIC <- sd_WAIC[idx_dic]
list(
promedio = promedio,
sd = sd_df
)
}
res1 <- resumen_sal(
repl_skewnormal_compare_dist_prediction,
"sal1reg",
c(1, 4, 7, 10)
)
res2 <- resumen_sal(
repl_skewnormal_compare_dist_prediction,
"sal2reg",
c(2, 5, 8, 11)
)
res3 <- resumen_sal(
repl_skewnormal_compare_dist_prediction,
"sal3reg",
c(3, 6, 9, 12)
)
save(
res1, res2, res3,repl_skewnormal_compare_dist_prediction,
file = "replications_1000_2reg_Forecast_Univariate_skew_normal1_20rep.rds"
)
mean(
sapply(
repl_skewstudent_compare_dist_prediction,
function(x) x$sal1reg[4, 4]
)
)
####Nueva con conteos----
resumen_sal <- function(lista, nombre_objeto, idx_dic) {
#----------------------------------
# SALXREG
#----------------------------------
dfs <- lapply(lista, function(x) x[[nombre_objeto]])
num_data <- lapply(
dfs,
function(df) df[, sapply(df, is.numeric)]
)
# Media
promedio <- Reduce("+", num_data) / length(num_data)
# SD
sd_df <- as.data.frame(
lapply(seq_along(num_data[[1]]), function(j) {
apply(
do.call(cbind, lapply(num_data, function(df) df[[j]])),
1,
sd
)
})
)
names(sd_df) <- names(num_data[[1]])
promedio$object <- dfs[[1]]$object
sd_df$object <- dfs[[1]]$object
promedio <- promedio[, c("object", setdiff(names(promedio), "object"))]
sd_df <- sd_df[, c("object", setdiff(names(sd_df), "object"))]
names(promedio)[4:5] <- c("APE", "WIDTH")
names(sd_df)[4:5] <- c("APE", "WIDTH")
#----------------------------------
# Función general:
# contar cuántas veces cada modelo
# es el mejor (menor valor)
#----------------------------------
contar_mejor_modelo <- function(lista_df, columnas = NULL, idx_modelos = NULL) {
if (is.null(columnas)) {
columnas <- 1
}
if (is.null(idx_modelos)) {
idx_modelos <- seq_len(nrow(lista_df[[1]]))
}
resultado <- data.frame(
Modelo = dfs[[1]]$object
)
for (j in columnas) {
# matriz:
# filas = modelos
# columnas = réplicas
mat <- do.call(
cbind,
lapply(lista_df, function(df) df[idx_modelos, j])
)
mejor_por_replica <- apply(mat, 2, which.min)
conteo <- table(
factor(
mejor_por_replica,
levels = 1:length(idx_modelos)
)
)
nombre_col <- names(lista_df[[1]])[j]
resultado[[paste0("Best_", nombre_col)]] <- as.numeric(conteo)
resultado[[paste0("Prop_", nombre_col)]] <- as.numeric(conteo) / length(lista_df)
}
resultado
}
#----------------------------------
# Selección mejor modelo en dfs
# (todas las columnas numéricas)
#----------------------------------
columnas_numericas <- which(
sapply(dfs[[1]], is.numeric)
)
seleccion_metricas <- contar_mejor_modelo(
lista_df = dfs,
columnas = columnas_numericas,
idx_modelos = 1:nrow(dfs[[1]])
)
#----------------------------------
# DIC
#----------------------------------
dic <- lapply(lista, function(x) x$DIC_models_dist)
promedio_DIC <- Reduce(
"+",
lapply(dic, function(df) df[[1]])
) / length(dic)
sd_DIC <- apply(
do.call(cbind, lapply(dic, function(df) df[[1]])),
1,
sd
)
seleccion_DIC <- contar_mejor_modelo(
lista_df = dic,
columnas = 1,
idx_modelos = idx_dic
)
#----------------------------------
# WAIC
#----------------------------------
waic <- lapply(lista, function(x) x$WAIC_models_dist)
promedio_WAIC <- Reduce(
"+",
lapply(waic, function(df) df[[1]])
) / length(waic)
sd_WAIC <- apply(
do.call(cbind, lapply(waic, function(df) df[[1]])),
1,
sd
)
seleccion_WAIC <- contar_mejor_modelo(
lista_df = waic,
columnas = 1,
idx_modelos = idx_dic
)
#----------------------------------
# Agregar criterios a promedio y sd
#----------------------------------
promedio$Valor_DIC <- promedio_DIC[idx_dic]
promedio$Valor_WAIC <- promedio_WAIC[idx_dic]
sd_df$sd_Valor_DIC <- sd_DIC[idx_dic]
sd_df$sd_Valor_WAIC <- sd_WAIC[idx_dic]
#----------------------------------
# Combinar selección DIC + WAIC
#----------------------------------
seleccion_criterios <- data.frame(
Modelo = dfs[[1]]$object,
Veces_mejor_DIC = seleccion_DIC$Best_Valor,
Prop_DIC = seleccion_DIC$Prop_Valor,
Veces_mejor_WAIC = seleccion_WAIC$Best_Valor,
Prop_WAIC = seleccion_WAIC$Prop_Valor
)
#----------------------------------
# Salida final
#----------------------------------
list(
promedio = promedio,
sd = sd_df,
seleccion_metricas = seleccion_metricas,
seleccion_criterios = seleccion_criterios
)
}
res2 <- resumen_sal(
lista = repl_skewnormal_compare_dist_prediction,
nombre_objeto = "sal3reg",
idx_dic = c(2, 5, 8, 11)
)
res2$seleccion_criterios
res2$seleccion_metricas
